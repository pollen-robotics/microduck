# The NFC reader daemon: touch a pairing tag, and the gamepad in pairing mode is paired.
#
# Nothing depends on this unit, and most robots have no reader fitted. `nfcd` then logs one line
# and retries the port every thirty seconds, so plugging a reader in is all it takes — no restart,
# nothing to enable.
[Unit]
Description=Robot NFC reader daemon
Documentation=file:///opt/robot/daemon/current/docs/architecture.md
# `After`, not `Requires`: a touch is answered by configd (pad.pair) and robotd (the quack), and
# each call opens its own connection, so either daemon may come and go under this one.
After=local-fs.target configd.service robotd.service

[Service]
Type=exec
ExecStart=/opt/robot/daemon/current/bin/nfcd
User=nfcd
Group=nfcd
# dialout — /dev/ttyACM* is root:dialout mode 0660, which is the whole of this daemon's
#           privileged access
# robot   — configd's, robotd's and mediad's 0660 sockets, mediad's for the photo tag's frame.
#           Asking configd to *pair* takes more than the group: configd.service names this
#           user in `--allow-user`.
SupplementaryGroups=dialout robot
Restart=always
RestartSec=5s

# Same hardening as `tofd`. `PrivateDevices=` is deliberately NOT set: it would hide the serial
# port, and the failure would read as "no reader fitted".
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

# At `warn`: every touch and what came of it, and when the reader comes and goes. Nothing per poll.
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal
# identity.json, for `robotctl health` and updaterd's startup check.
RuntimeDirectory=nfcd
# The photo tag's pictures, /var/lib/robot/photos, kept across reboots and updates.
StateDirectory=robot/photos

[Install]
WantedBy=multi-user.target
