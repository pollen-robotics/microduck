[Unit]
Description=Development authenticated media gateway
After=network.target mediad.service
Wants=mediad.service

[Service]
Type=exec
User=btd
Group=btd
LoadCredential=ble-psk:/var/lib/robot/config/ble-psk
# The robot id is its first name, derived from the SoC serial, so no flag carries it.
ExecStart=/opt/robot/daemon/current/bin/duck-gateway --key-file %d/ble-psk
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

# Intentionally no [Install]: provision and start this development service explicitly.
