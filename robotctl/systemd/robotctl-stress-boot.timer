# When to ask whether this boot should start a stress run (`robotctl-stress-boot.service`).
#
# A timer rather than an enabled service so that only a boot starts it: `hooks/postinstall`
# enables timers without starting them, and an `OnBootSec=` timer does not fire again until the
# next boot.

[Unit]
Description=Start robotctl stress at boot if [stress] on_boot is set

[Timer]
# Ten seconds, not one: the person who switched the robot on is usually holding it, and needs
# a moment to set it down in its square before the first walk. The oneshot then waits for robotd
# to be publishing state, which on a cold boot is most of the wait anyway.
OnBootSec=10

AccuracySec=1s

[Install]
WantedBy=timers.target
